    "stack.agent.preset.default",
    "stack.agent.skills",
    "stack.agent.tools",
    "stack.agent.translator",
    "stack.ai.dialects",
    "stack.ai.provider-rotation",
    "stack.ai.providers",
    "stack.core.composition",
    "stack.dev.formatters",
    "stack.dev.lsp",
    "stack.security.credentials",
    "stack.trading.backtest",
    "stack.trading.market-data",
    "stack.trading.optimizer",
    "stack.trading.research",
    "stack.tweaks",
    "stack.tweaks.drag-drop",
    "stack.tweaks.fork-undo",
    "stack.tweaks.keybinds",
    "stack.tweaks.plan-toggle",
