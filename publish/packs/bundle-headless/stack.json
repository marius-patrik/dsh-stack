{
  "id": "stack.pack.bundle-headless",
  "name": "@dsh-stack/pack-bundle-headless",
  "version": "0.1.0",
  "kind": "pack",
  "description": "Harness-bootable dsh.bundle wrapper composing the headless-safe subset of the dsh-stack catalog (every package the full bundle mounts whose declared inject list names neither webServer nor loader) into one cordis.patch.yml, so a dsh --profile headless boot can compose real Stack packages -- providers/provider-rotation account routing above all -- with a single dsh.profile.bundles entry.",
