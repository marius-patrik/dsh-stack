{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!**/node_modules",
      "!**/dist",
      "!packages/**/lib",
      "!**/.turbo",
      "!**/.next",
      "!worktrees",
      "!**/worktrees",
      "!packages/Cognition",
      "!packages/Cognition/**",
      "!packages/DarkFactory",
      "!packages/DarkFactory/**",
      "!packages/dsh-tui",
      "!packages/dsh-tui/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "bracketSameLine": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  }
}
