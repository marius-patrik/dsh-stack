{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["script", "dns-sd", "sips", "tailscale"],
  "rules": {
    "duplicates": "warn"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/**/*.test.mjs", "scripts/client-runtime/*.js"],
      "project": ["scripts/**/*.{mjs,js}"]
    },
    "plugins/stack/**": {
      "entry": [
        "src/index.{ts,tsx,mjs,js}",
        "src/client.{ts,tsx}",
        "client.js",
        "*.mjs",
        "bin/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.mjs", "bin/*.mjs"]
    },
    "plugins/stack/ai/providers/providers": {
      "entry": [
        "src/index.{ts,tsx,mjs,js}",
        "src/client.{ts,tsx}",
        "client.js",
        "*.mjs",
        "bin/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.mjs", "bin/*.mjs"],
      "ignoreDependencies": ["@dsh-stack/sidebar-preferences"]
    },
    "plugins/stack": {
      "entry": ["src/index.{ts,tsx,mjs,js}", "*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "*.mjs"],
      "ignoreDependencies": ["@dsh-stack/.+"]
    },
    "plugins/headless": {
      "entry": ["src/index.{ts,tsx,mjs,js}", "*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "*.mjs"],
      "ignoreDependencies": ["@dsh-stack/.+"]
    },
    "plugins/stack/ux/themes/skin-claude": {
      "entry": ["src/index.{ts,tsx,mjs,js}", "src/client.{ts,tsx}", "*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "*.mjs"],
      "ignoreDependencies": ["@types/react"]
    },
    "plugins/stack/ux/themes/skin-codex": {
      "entry": ["src/index.{ts,tsx,mjs,js}", "src/client.{ts,tsx}", "*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "*.mjs"],
      "ignoreDependencies": ["@types/react"]
    }
  },
  "ignoreDependencies": ["@deepseek-ai/dsh-client-ui-slots"]
}
