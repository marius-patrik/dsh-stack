{
  "name": "@dsh-stack/providers",
  "description": "Subscription and API provider adapters for dsh, wired onto Stack dialects and the harness credential seam",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web",
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./quotas": {
      "types": "./lib/quotas/index.d.ts",
      "default": "./lib/quotas/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets",
    "client.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && cat ../../scripts/client-runtime/crypto-polyfill.js ../../scripts/client-runtime/glyph-factory.js client.js > lib/client.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "node check-plugin.mjs"
  },
  "dependencies": {
    "@dsh-stack/dialects": "workspace:*",
    "@dsh-stack/credential-vault": "workspace:*",
    "@dsh-stack/plugin-kit": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "react": "^18.2.0",
    "@dsh-stack/dialects": "workspace:*",
    "@dsh-stack/credential-vault": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@dsh-stack/dialects": "workspace:*",
    "@dsh-stack/credential-vault": "workspace:*"
  },
  "stack": {
    "kind": "plugin",
    "id": "stack.ai.providers"
  },
  "publishConfig": {
    "access": "public"
  }
}
