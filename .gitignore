# dependencies
node_modules/
.hub/
.vite/

# git worktrees
/worktrees/

# harness build output
harness/apps/*/lib/
harness/packages/*/lib/
harness/*/dist/

# stack package build output
plugins/*/lib/
packages/*/lib/
extensions/*/lib/
packs/*/lib/

# state (never commit) — .agents/ in repo is docs + hooks (tracked);
# ~/.agents is the harness home (state folder, never committed).
# .data/ is an alternate rehomed harness home root (dsh-tweaks.homeRoot
# pointed at <repo>/.data instead of ~/.agents); its contents are pure
# runtime state, never committed.
.data/
.agents/*
!.agents/*.md
!.agents/hooks/
!.agents/hooks/**
!.agents/rules/
!.agents/rules/**
!.agents/requests/
!.agents/requests/**
.dsh/
.credentials.yaml
accounts.vault

# secrets / browser artifacts
*.vscdb
*cookies*
*.pem

# editor
.DS_Store

# release build output
/.release/
