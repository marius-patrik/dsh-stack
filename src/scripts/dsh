#!/usr/bin/env bash
# dsh — homeRoot/command-aware launcher and service manager for DeepSeek Harness.
#
# Usage:
#   dsh restart      Gracefully restart the dsh web server and show health
#   dsh start        Start the dsh web server in the background
#   dsh stop         Stop the running dsh web server
#   dsh status       Show process status, URLs (Local + Tailscale), and plugin health
#   dsh logs [-f]    View or tail the web server logs
#   dsh <verb>       Plugin verbs (accounts, stats, sessions, share, theme, lsp, formatter, agents)
#   dsh [args...]    Fall-through to the harness CLI
set -euo pipefail

# Resolve symlink to real location
source_path="${BASH_SOURCE[0]}"
while [ -h "$source_path" ]; do
  dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink "$source_path")"
  [[ $source_path != /* ]] && source_path="$dir/$source_path"
done
here="$(cd -P "$(dirname "$source_path")" && pwd)"
harness_dir="$(cd "$here/../../harness" && pwd)"
bin="$harness_dir/apps/cli/lib/bin.js"
ts_bin="$harness_dir/apps/cli/src/bin.ts"
log_file="/private/tmp/dsh-web.log"
port=3080

invoked_name="$(basename "$0")"
if [[ "$invoked_name" == "dsh-restart" && $# -eq 0 ]]; then
  set -- "restart"
fi

# Read the `dsh-tweaks` section of a settings document (homeRoot, command).
read_tweaks() {
  node - "$1" <<'EOF'
const fs = require('node:fs')
const path = process.argv[2]
const out = {}
try {
  const lines = fs.readFileSync(path, 'utf8').split('\n')
  let inSection = false
  for (const line of lines) {
    if (/^dsh-tweaks\s*:/.test(line)) { inSection = true; continue }
    if (inSection && !/^\s/.test(line)) break
    if (!inSection) continue
    const m = line.match(/^\s+([A-Za-z_][A-Za-z0-9_-]*)\s*:\s*(.*)$/)
    if (m && (m[1] === 'homeRoot' || m[1] === 'command')) {
      out[m[1]] = m[2].trim().replace(/^(['"])(.*)\1$/, '$2')
    }
  }
} catch { /* missing or unparsable document: no tweaks */ }
process.stdout.write(JSON.stringify(out))
EOF
}

pick() {
  node -e 'const t = JSON.parse(process.argv[1]); process.stdout.write(t[process.argv[2]] ?? "")' "$1" "$2"
}

home="${DSH_HOME:-$HOME/.agents}"
tweaks="$(read_tweaks "$home/settings.yaml")"
home_root="$(pick "$tweaks" homeRoot)"
command_override="$(pick "$tweaks" command)"

if [[ -n "$home_root" && "$home_root" != "$home" ]]; then
  echo "dsh: dsh-tweaks.homeRoot moved state $home -> $home_root" >&2
  mkdir -p "$home_root"
  for d in profiles sessions vault; do
    if [[ -d "$home/$d" && ! -e "$home_root/$d" ]]; then cp -R "$home/$d" "$home_root/$d"; fi
  done
  for f in settings.yaml .credentials.yaml accounts.vault accounts.key; do
    if [[ -f "$home/$f" && ! -e "$home_root/$f" ]]; then cp "$home/$f" "$home_root/$f"; fi
  done
  home="$home_root"
fi

if [[ "$#" -eq 0 && -n "$command_override" ]]; then
  # Word-splitting is intentional: a settings command is an argv fragment.
  set -- $command_override
fi

export DSH_HOME="$home"

get_server_pid() {
  lsof -ti :"$port" -sTCP:LISTEN 2>/dev/null || true
}

get_tailscale_info() {
  if command -v tailscale >/dev/null 2>&1; then
    local ts_ip
    ts_ip="$(tailscale ip -4 2>/dev/null || true)"
    local ts_dns
    ts_dns="$(tailscale status --json 2>/dev/null | node -e '
      let d="";
      process.stdin.on("data", c=>d+=c).on("end", ()=>{
        try {
          const j=JSON.parse(d);
          const self = j.Self || {};
          const dns = (self.DNSName || "").replace(/\.$/, "");
          process.stdout.write(dns);
        } catch(e){}
      })
    ' 2>/dev/null || true)"
    echo "$ts_ip|$ts_dns"
  else
    echo "|"
  fi
}

do_status() {
  local pid
  pid="$(get_server_pid)"
  if [[ -n "$pid" ]]; then
    local ts_info
    ts_info="$(get_tailscale_info)"
    local ts_ip="${ts_info%%|*}"
    local ts_dns="${ts_info##*|}"
    local main_url="http://127.0.0.1:$port"
    if [[ -n "$ts_dns" ]]; then
      main_url="http://$ts_dns:$port"
    elif [[ -n "$ts_ip" ]]; then
      main_url="http://$ts_ip:$port"
    fi
    echo "● dsh web server is running (PID: $pid)"
    echo "  Address: $main_url"
    echo "  Logs:    $log_file"

    # Query health check via Typert
    local inventory
    inventory="$(curl -s --max-time 3 -X POST "http://127.0.0.1:$port/api/pluginInventory/list" \
      -H 'Content-Type: application/json' \
      -d '{"type":"client-request","rpcId":"status","method":"pluginInventory/list","payload":{"args":{}}}' 2>/dev/null || true)"
    if [[ -n "$inventory" ]]; then
      node -e "
        try {
          const res = JSON.parse(process.argv[1]).result;
          if (res && res.ok) {
            const entries = res.value.entries || [];
            const active = entries.filter(e => e.fiberPhase === 'active').length;
            const failed = entries.filter(e => e.fiberPhase === 'failed');
            console.log('  Plugins:       ' + active + '/' + entries.length + ' active (' + failed.length + ' failed)');
            if (failed.length > 0) {
              failed.slice(0, 5).forEach(f => console.log('    ✗ Failed: ' + f.entryId + ' (' + f.moduleName + ')'));
            }
          }
        } catch(e) {}
      " "$inventory"
    fi
  else
    echo "○ dsh web server is not running (port $port is free)"
  fi
}

do_stop() {
  local pid
  pid="$(get_server_pid)"
  if [[ -z "$pid" ]]; then
    echo "dsh: web server is not running on port $port"
    return 0
  fi
  echo "dsh: stopping web server (PID: $pid)..."
  kill -TERM "$pid" 2>/dev/null || true
  local count=0
  while [[ -n "$(get_server_pid)" && "$count" -lt 30 ]]; do
    sleep 0.2
    count=$((count + 1))
  done
  if [[ -n "$(get_server_pid)" ]]; then
    echo "dsh: force killing PID $pid..."
    kill -9 "$pid" 2>/dev/null || true
    sleep 0.5
  fi
  echo "dsh: web server stopped."
}

do_start() {
  local pid
  pid="$(get_server_pid)"
  if [[ -n "$pid" ]]; then
    echo "dsh: web server is already running (PID: $pid on port $port)"
    return 0
  fi
  echo "dsh: starting web server on port $port..."
  (cd "$harness_dir" && nohup node --import tsx/esm "$ts_bin" web --port "$port" > "$log_file" 2>&1 &)
  
  local count=0
  while [[ -z "$(get_server_pid)" && "$count" -lt 50 ]]; do
    sleep 0.2
    count=$((count + 1))
  done
  
  pid="$(get_server_pid)"
  if [[ -n "$pid" ]]; then
    echo "dsh: web server started successfully (PID: $pid)"
    do_status
  else
    echo "dsh: failed to start web server. Check logs: $log_file" >&2
    tail -n 20 "$log_file" >&2
    return 1
  fi
}

do_restart() {
  echo "dsh: restarting web server..."
  do_stop
  do_start
}

do_logs() {
  if [[ ! -f "$log_file" ]]; then
    echo "dsh: no log file found at $log_file"
    return 0
  fi
  if [[ $# -eq 0 ]]; then
    tail -n 50 "$log_file"
  elif [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then
    shift
    tail -f "$@" "$log_file"
  else
    tail "$@" "$log_file"
  fi
}

# --- Subcommand routing ---

if [[ "${1:-}" == "status" ]]; then
  do_status
  exit 0
fi

if [[ "${1:-}" == "restart" ]]; then
  do_restart
  exit 0
fi

if [[ "${1:-}" == "start" ]]; then
  do_start
  exit 0
fi

if [[ "${1:-}" == "stop" ]]; then
  do_stop
  exit 0
fi

if [[ "${1:-}" == "logs" || "${1:-}" == "log" ]]; then
  shift
  do_logs "$@"
  exit 0
fi

if [[ "${1:-}" == "accounts" ]]; then
  shift
  exec node "$here/../plugins/dsh-credentials/bin/accounts.mjs" "$@"
fi

if [[ "${1:-}" == "stats" || "${1:-}" == "sessions" || "${1:-}" == "share" ]]; then
  verb="${1}"
  shift
  exec node "$here/../plugins/dsh-tweaks/bin/${verb}.mjs" "$@"
fi

if [[ "${1:-}" == "theme" ]]; then
  shift
  exec node "$here/../plugins/dsh-themes/bin/theme.mjs" "$@"
fi

if [[ "${1:-}" == "lsp" ]]; then
  shift
  exec node "$here/../plugins/dsh-lsp/bin/lsp.mjs" "$@"
fi

if [[ "${1:-}" == "formatter" ]]; then
  shift
  exec node "$here/../plugins/dsh-formatters/bin/formatter.mjs" "$@"
fi

if [[ "${1:-}" == "agents" ]]; then
  shift
  exec node "$here/../plugins/dsh-agents/bin/agents.mjs" "$@"
fi

if [[ -f "$ts_bin" ]]; then
  exec node --import tsx/esm "$ts_bin" "$@"
else
  exec node "$bin" "$@"
fi
