{
  "name": "@marius-patrik/dsh-stack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "npx --yes @biomejs/biome@2.2.0 format --write .",
    "format:check": "npx --yes @biomejs/biome@2.2.0 format --write . && git diff --exit-code",
    "verify:plugin-readmes": "node scripts/verify-plugin-readmes.mjs",
    "verify:jsdocs": "node scripts/verify-jsdocs.mjs",
    "verify:duplicates": "pnpm dlx jscpd@5.0.16 --min-lines 5 --min-tokens 50 --threshold 0 --ignore '**/{node_modules,lib,dist,.next,.turbo}/**' packages plugins scripts",
    "verify:dead-code": "pnpm dlx knip@6.32.2 --no-progress",
    "verify": "pnpm run verify:plugin-readmes && pnpm run verify:jsdocs && pnpm run verify:duplicates && pnpm run verify:dead-code && node scripts/verify-stack.mjs && pnpm -r --if-present verify",
    "test": "pnpm -r --if-present test",
    "release:manifest": "node scripts/release.mjs manifest",
    "release:version": "node scripts/release.mjs version",
    "release:assets": "node scripts/release.mjs assets && node scripts/release-assets.mjs",
    "release:verify": "node scripts/verify-release-assets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^22.15.0",
    "typescript": "^6.0.3"
  }
}
