{
  "name": "@marius-patrik/dsh-stack",
  "version": "0.1.0-rewrite.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:stack": "node scripts/verify-stack.mjs",
    "verify": "pnpm run verify:stack && pnpm -r --if-present verify",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
