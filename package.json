{
  "name": "@marius-patrik/dsh-stack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present --workspace-concurrency=16 build",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=16 typecheck",
    "format": "npx --yes @biomejs/biome@2.2.0 format --write .",
    "format:check": "npx --yes @biomejs/biome@2.2.0 format --write . && git diff --exit-code",
    "verify:plugin-readmes": "node src/scripts/verify-plugin-readmes.mjs",
    "verify:jsdocs": "node src/scripts/verify-jsdocs.mjs",
    "verify:duplicates": "jscpd src/packages publish/extensions publish/packs publish/plugins src/scripts",
    "verify:dead-code": "knip --no-progress",
    "verify": "pnpm run verify:plugin-readmes && pnpm run verify:jsdocs && pnpm run verify:duplicates && pnpm run verify:jscpd-exemptions && pnpm run verify:dead-code && pnpm run verify:reachability && pnpm run verify:non-cordis-exclusions && pnpm run verify:stateful-client-packages && node src/scripts/verify-stack.mjs && pnpm -r --if-present --workspace-concurrency=16 verify",
    "test": "node --test 'src/scripts/**/*.test.mjs' && pnpm -r --if-present --workspace-concurrency=16 test",
    "release:manifest": "node src/scripts/release.mjs manifest",
    "release:version": "node src/scripts/release.mjs version",
    "release:assets": "node src/scripts/release.mjs assets",
    "release:verify": "node src/scripts/verify-release-assets.mjs",
    "verify:reachability": "node src/scripts/verify-package-reachability.mjs",
    "verify:non-cordis-exclusions": "node src/scripts/verify-non-cordis-exclusions.mjs",
    "verify:stateful-client-packages": "node src/scripts/verify-stateful-client-packages.mjs",
    "verify:jscpd-exemptions": "node src/scripts/verify-jscpd-exemptions.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^22.15.0",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
