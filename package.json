{
  "name": "@marius-patrik/dsh-stack",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "packages/stack/**"
  ],
  "trustedDependencies": [
    "koffi"
  ],
  "scripts": {
    "build": "node packages/stack/plugin-kit/tooling/build/generate-bundles.mjs && node packages/stack/plugin-kit/tooling/build/build-workspace.mjs",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "format": "biome format --write .",
    "format:check": "biome format --write . && git diff --exit-code",
    "verify:plugin-readmes": "node packages/stack/plugin-kit/tooling/verify/verify-plugin-readmes.mjs",
    "verify:jsdocs": "node packages/stack/plugin-kit/tooling/verify/verify-jsdocs.mjs",
    "verify:duplicates": "jscpd packages .github/scripts",
    "verify:dead-code": "knip --no-progress",
    "verify": "bun run verify:plugin-readmes && bun run verify:jsdocs && bun run verify:duplicates && bun run verify:jscpd-exemptions && bun run verify:dead-code && bun run verify:stateful-client-packages && bun run verify:bundle-composition && node packages/stack/plugin-kit/tooling/verify/verify-stack.mjs && bun run --filter '*' --if-present verify",
    "test": "node --test '.github/scripts/**/*.test.mjs' && bun run --filter '*' --if-present test",
    "release:manifest": "node .github/scripts/release.mjs manifest",
    "release:version": "node .github/scripts/release.mjs version",
    "release:assets": "node .github/scripts/release.mjs assets",
    "release:verify": "node .github/scripts/verify-release-assets.mjs",
    "verify:stateful-client-packages": "node packages/stack/plugin-kit/tooling/verify/verify-stateful-client-packages.mjs",
    "verify:jscpd-exemptions": "node packages/stack/plugin-kit/tooling/verify/verify-jscpd-exemptions.mjs",
    "browser:check": "node packages/stack/plugin-kit/tooling/verify/browser-check.mjs",
    "verify:bundle-composition": "node packages/stack/plugin-kit/tooling/build/generate-bundles.mjs --check",
    "release:local-fixtures": "node .github/scripts/release.mjs local-fixtures"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^22.15.0",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "playwright": "1.61.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
