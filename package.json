{
  "name": "@marius-patrik/dsh-stack",
  "version": "0.1.0-rewrite.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "plugins/**"
  ],
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify:stack": "node scripts/verify-stack.mjs",
    "verify": "pnpm run verify:stack && pnpm -r --if-present verify",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@types/node": "^22.15.0",
    "typescript": "^6.0.3"
  }
}
