#!/bin/sh
# pre-push hook — validates plugin check suites before push
#
# Install: .agents/hooks/install.sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "Running plugin check-plugin suites..."

failed=""
while IFS= read -r check_file; do
  pkg_dir="$(dirname "$check_file")"
  rel_name="${pkg_dir#"$REPO_ROOT"/plugins/}"
  echo -n "  $rel_name... "
  if (cd "$pkg_dir" && node check-plugin.mjs) > /dev/null 2>&1; then
    echo "ok"
  else
    echo "FAILED"
    failed="$failed $rel_name"
  fi
done < <(find "$REPO_ROOT/plugins" -name "check-plugin.mjs" | sort)

if [ -n "$failed" ]; then
  echo ""
  echo "ERROR: Failed check-plugin suites:$failed"
  echo "Fix before pushing."
  exit 1
fi

echo "All plugin checks passed."
