#!/bin/sh
# pre-commit hook — enforces workflow rules before commit
#
# Install: .agents/hooks/install.sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
AGENTS_DIR="$REPO_ROOT/.agents"

# --- 1. No secrets in staged files ---
# Block OAuth client secrets, vault master keys, and similar credentials
if git diff --cached --diff-filter=ACM -p | grep -qiE '(GOCSPX-[a-zA-Z0-9_-]{20,}|client_secret[:=]["\x27 ][a-zA-Z0-9_-]{20,}|master.key.*=.*[a-zA-Z0-9+/=]{30,})'; then
  echo "ERROR: Possible secret detected in staged files."
  echo "Review the diff and use vault refs or env vars instead."
  exit 1
fi

# --- 2. check-plugin.mjs must not ship without src/ changes ---
# If a plugin's check-plugin.mjs is staged, at least one src/ file must also be staged
for plugin_dir in "$REPO_ROOT"/plugins/*/; do
  plugin_name="$(basename "$plugin_dir")"
  if git diff --cached --name-only | grep -q "^plugins/$plugin_name/check-plugin\.mjs$"; then
    if ! git diff --cached --name-only | grep -q "^plugins/$plugin_name/src/"; then
      echo "WARNING: $plugin_name/check-plugin.mjs staged without src/ changes."
      echo "This is allowed but unusual — verify the check update is intentional."
    fi
  fi
done

# --- 3. No node_modules or build artifacts staged ---
if git diff --cached --name-only | grep -E '(^|/)node_modules/|(^|/)lib/client\.js$)'; then
  # Allow lib/client.js only if client.js is also staged (copy pattern)
  artifacts="$(git diff --cached --name-only | grep -E '(^|/)node_modules/' || true)"
  if [ -n "$artifacts" ]; then
    echo "ERROR: node_modules staged. Add it to .gitignore."
    exit 1
  fi
fi

# --- 4. Docs consistency: if any plugin src changed, warn if docs not staged ---
docs_files=""
for doc in PLAN.md CONTEXT.md BACKLOG.md README.md AGENTS.md PRD.md BLOCKED.md; do
  if git diff --cached --name-only | grep -q "^\.agents/$doc$"; then
    docs_files="$docs_files $doc"
  fi
done

plugin_src_changed="$(git diff --cached --name-only | grep -E '^plugins/[^/]+/src/' | head -1 || true)"
if [ -n "$plugin_src_changed" ] && [ -z "$docs_files" ]; then
  echo "NOTE: Plugin source changed but no docs staged under .agents/."
  echo "Consider updating PLAN.md, BACKLOG.md, or CONTEXT.md if this is a phase boundary."
fi

echo "pre-commit checks passed."

# --- 5. Rules system integrity ---
# Verify that all 6 rule files exist under .agents/rules/
missing_rules=""
for rule in 01-context-load.md 02-blocked-gate.md 03-vague-input.md 04-digestion-pipeline.md 05-user-input-gate.md 06-subagent-utilization.md; do
  if [ ! -f "$AGENTS_DIR/rules/$rule" ]; then
    missing_rules="$missing_rules $rule"
  fi
done
if [ -n "$missing_rules" ]; then
  echo "ERROR: Missing rule files:$missing_rules"
  echo "All 6 rule files must exist under .agents/rules/."
  exit 1
fi

# --- 6. Requests folder exists ---
if [ ! -d "$AGENTS_DIR/requests" ]; then
  echo "ERROR: .agents/requests/ directory missing."
  echo "Create it with: mkdir -p .agents/requests"
  exit 1
fi
