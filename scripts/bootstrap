#!/usr/bin/env bash
# bootstrap — developer-only install/build/typecheck for an external DSH checkout.
# CI=true skips upstream hook installation in isolated test checkouts.
set -euo pipefail
harness="${DSH_HARNESS:?Set DSH_HARNESS to an external DeepSeek Harness checkout}"
if [ ! -f "$harness/pnpm-workspace.yaml" ]; then
  echo "bootstrap: DSH_HARNESS is not an upstream harness checkout: $harness" >&2
  exit 1
fi

# The harness is upstream and keeps its own pnpm workspace: pnpm-workspace.yaml
# carries patchedDependencies, peerDependencyRules, minimumReleaseAgeExclude and
# linkWorkspacePackages, none of which bun supports. Stack itself runs on bun;
# the harness stays on pnpm, and this script is the boundary between the two.
#
# packages/boot/app-boot's compiled output imports "resolve.exports" without
# declaring it in any package.json dependency list in the chain (upstream
# harness bug, tracked at dsh-stack#181/#169 — this external DSH checkout should
# not be patched in the Stack repository). `pnpm install` reports "up to date" while
# every dsh profile still fails to boot with ERR_MODULE_NOT_FOUND. Symlink
# it in from the pnpm store as a local workaround until the upstream
# app-boot package.json declares it for real.
fix_known_install_gaps() {
  local target="$harness/node_modules/resolve.exports"
  [ -e "$target" ] && return 0
  local store_pkg
  store_pkg="$(find "$harness/node_modules/.pnpm" -maxdepth 1 -iname 'resolve.exports@*' -print -quit 2>/dev/null)"
  if [ -z "$store_pkg" ]; then
    echo "bootstrap: resolve.exports missing from harness node_modules AND not present in the pnpm store — dsh will fail to boot (ERR_MODULE_NOT_FOUND from packages/boot/app-boot). See dsh-stack#181." >&2
    return 0
  fi
  echo "bootstrap: external DSH/packages/boot/app-boot imports resolve.exports without declaring it (dsh-stack#181) — symlinking from the pnpm store as a workaround" >&2
  ln -s "$store_pkg/node_modules/resolve.exports" "$target"
}

cmd="${1:-all}"
case "$cmd" in
  install) CI=true pnpm install -C "$harness" && fix_known_install_gaps ;;
  build)   CI=true pnpm -C "$harness" run build ;;
  typecheck) CI=true pnpm -C "$harness" run typecheck ;;
  all)     CI=true pnpm install -C "$harness" \
           && fix_known_install_gaps \
           && CI=true pnpm -C "$harness" run build \
           && CI=true pnpm -C "$harness" run typecheck ;;
  *) echo "usage: $0 [install|build|typecheck|all]" >&2; exit 2 ;;
esac
